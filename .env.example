# Supabase (service role — server-side only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# Shared secret n8n sends as the `x-internal-api-key` header when calling
# /api/cron/trend-digest. Generate any long random string.
INTERNAL_API_KEY=

# Base URL used to build CTA and unsubscribe links in the digest email.
APP_BASE_URL=https://app.somesoftware.io

# When "true", /api/cron/trend-digest runs entirely on hardcoded fixture data
# and logs to the console instead of calling Supabase/Resend. Lets the full
# chain (auth, n8n reachability, email rendering, logging) be verified with
# zero production credentials — only INTERNAL_API_KEY is required.
MOCK_MODE=true

# Optional: locks down /api/generate-email the same way (Authorization: Bearer <key>).
GENERATE_EMAIL_API_KEY=
